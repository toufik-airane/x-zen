{
  "manifest_version": 3,
  "name": "x-zen",
  "version": "1.0.10",
  "minimum_chrome_version": "116",
  "description": "Clean up X and stop rapid Home clicks from refreshing the feed.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": ["storage", "geolocation", "alarms", "offscreen"],
  "host_permissions": ["https://api.open-meteo.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["assets/backgrounds/peaceful-plants.jpg"],
      "matches": ["https://x.com/*", "https://www.x.com/*"]
    }
  ],
  "action": {
    "default_title": "x-zen",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://www.x.com/*"],
      "css": ["styles.css"],
      "js": [
        "shared.js",
        "content.js",
        "hourly-bell.js",
        "pomodoro.js",
        "weather.js",
        "outline-label.js",
        "outline.js"
      ],
      "run_at": "document_start"
    }
  ]
}
